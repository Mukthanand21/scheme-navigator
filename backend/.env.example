# ─── CognoDB Cloud Connection Credentials ────────────────────────────────────
# Get these from your CognoDB Cloud dashboard after creating an instance.
# All three are REQUIRED — the app will exit at startup with a clear error
# message if any of them is missing or empty.

# Bolt URI for your CognoDB instance.
# Format: bolt+s://db-<id>.databases.cognodb.cloud
# If missing: App exits immediately — no routes will be available.
COGNODB_URI=bolt+s://your-instance.databases.cognodb.cloud

# Username for CognoDB authentication.
# Typically "cognodb" for all CognoDB Cloud instances.
# If missing: App exits immediately — cannot authenticate.
COGNODB_USER=cognodb

# Password for CognoDB authentication.
# Shown only once when you create the instance — save it securely.
# If missing: App exits immediately — cannot authenticate.
# If wrong: App starts but all DB routes return 503 with "AuthError".
COGNODB_PASSWORD=your-password-here
